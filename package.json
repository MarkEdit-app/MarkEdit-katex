{
    "name": "markedit-katex",
    "version": "1.1.6",
    "description": "Markdown-it plugin that provides MarkEdit's KaTeX support",
    "main": "dist/index.js",
    "types": "types.d.ts",
    "files": [
        "dist/*",
        "types.d.ts"
    ],
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./types.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./types.d.ts": "./types.d.ts"
    },
    "scripts": {
        "compile": "node build/compile.js",
        "verify-dist": "node build/verify-dist.js",
        "watch": "node build/compile.js --watch",
        "test": "node test/all.js && node test/package.js",
        "test-render": "node test/test-render.js test/test.md > test/out.html"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/MarkEdit-app/MarkEdit-katex.git"
    },
    "keywords": [
        "markdown",
        "KaTeX",
        "math",
        "LaTeX",
        "markdown-it-plugin",
        "markdown-it"
    ],
    "author": {
        "name": "Microsoft Corporation"
    },
    "license": "MIT",
    "dependencies": {
        "katex": "^0.18.4"
    },
    "devDependencies": {
        "@types/markdown-it": "^12.2.3",
        "markdown-it": "^14.0.0",
        "markdown-it-testgen": "^0.1.6",
        "tape": "^5.6.0",
        "typescript": "^5.3.0"
    }
}
